# Copy to .env.local for local dev, or set these in Render environment settings.

# Signing key for CAPTCHA challenges. MUST be a strong random value in prod.
# Generate with: openssl rand -hex 32
AUTH_SECRET=

# Optional dedicated secret for signing CAPTCHA challenges.
# Falls back to AUTH_SECRET when unset.
CAPTCHA_SECRET=

# Canonical public origin, e.g. https://ultron.example.com — used to build the
# password-reset link. STRONGLY RECOMMENDED in production: without it the link is
# built from the request's Host header, which a client controls, so a spoofed
# Host would put an attacker's domain into a reset email.
APP_ORIGIN=

# SMTP, used to send password-reset email. Leave SMTP_HOST empty to disable
# outbound mail entirely — the reset endpoint still answers normally (it must
# never reveal whether an account exists), and outside production it logs the
# reset link to the server console so the flow can be tested without a mail host.
# Port 587 = STARTTLS (default), 465 = implicit TLS. Omit SMTP_USER/SMTP_PASS for
# an unauthenticated relay.

SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=noreplyrotocorp@gmail.com
SMTP_PASSWORD=eicvqrbytefyitud
SMTP_FROM="Oswar Rotocorp <noreplyrotocorp@gmail.com>"

# REQUIRED in production: Supabase PostgreSQL connection string. Users, opaque
# login sessions, settings, asset hierarchy, rack cards, and canvas layouts are
# all persisted here and survive deploys/restarts.
# Local example:
#   DATABASE_URL=postgres://user:pass@localhost:5432/ultron
# Supabase example (Project Settings -> Database -> Connection string -> URI):
#   DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=

# --- MQTT ingest, inside this application --------------------------------
# The app subscribes to EMQX itself (src/server/ingest), started by server.mjs.
# Nothing calls in: the gateway publishes to the broker, this process subscribes
# to the broker, and browsers subscribe to this process at /ws/live.
#
#   mqtt      = broker subscription only (the pub/sub model; use this)
#   both      = broker + the direct gateway WebSocket door, as a broker-outage
#               fallback (then set DIRECT_WS_GATEWAY_SECRET)
#   websocket = direct gateway door only, no broker
INGEST_TRANSPORT=mqtt
PERSISTENCE_ENABLED=true
# Only needed when the live socket is served from another origin; same-origin
# /ws/live is the default and needs no configuration.
NEXT_PUBLIC_ULTRON_LIVE_WS_URL=
# Require a logged-in session on /ws/live. Defaults to on in production.
LIVE_WS_REQUIRE_SESSION=true
# Fallback door only (INGEST_TRANSPORT=both|websocket); must match the gateway's
# DIRECT_WS_TOKEN. Leave empty in the pub/sub configuration.
DIRECT_WS_GATEWAY_SECRET=

# Optional secret for cron/manual maintenance calls.
# Authorizes POST/GET /api/reputation/process, which drains the durable
# Abstract email-reputation queue at <= 1 request/second. Signup and the Manage
# Users "Re-check" button drain it on demand, so scheduling this is OPTIONAL —
# add it as a scheduled job only if you want backlog stragglers processed
# automatically (e.g. `Authorization: Bearer $CRON_SECRET`).
CRON_SECRET=

# Gateways with no message for this long are marked OFFLINE (last-will backstop,
# swept by the ingest runtime every 5s).
STALE_AFTER_S=15

# EMQX connection used for both the subscription and command publishes. The
# broker user needs subscribe on ultron/v1/gateways/# and publish on
# ultron/v1/gateways/+/racks/+/commands/request.
MQTT_HOST=
MQTT_PORT=8883
MQTT_USE_TLS=true
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_CA_CERT=
MQTT_CLIENT_CERT=
MQTT_CLIENT_KEY=
# Client id prefix; a random suffix is appended per instance so two app
# instances never evict each other from the broker.
MQTT_BACKEND_CLIENT_ID=ultron-app-ingest
MQTT_SUBSCRIBE_QOS=1
# EMQX speaks MQTT 5. Set 4 only for a broker limited to 3.1.1.
MQTT_PROTOCOL_VERSION=5
MQTT_MAX_PAYLOAD_BYTES=262144
# How long POST /api/live/command waits for the gateway's commands/response.
MQTT_COMMAND_TIMEOUT_MS=10000

# Per-payload latency, reported at GET /health and by
# scripts/Measure-IngestLatency.ps1. LATENCY_WINDOW is how many recent payloads
# the percentiles are computed over. LATENCY_LOG_EVERY logs one line per Nth
# payload (0 = off, 1 = every message - noisy at 2 Hz per rack).
LATENCY_WINDOW=1000
LATENCY_LOG_EVERY=0

# Realtime delivery (/api/live/stream). Ingest publishes each validated message
# as a live frame on the `ultron_live` PostgreSQL NOTIFY channel before it writes
# anything, and the stream forwards it straight to the browser.
# LISTEN needs a session-mode connection: Supabase's transaction pooler (port
# 6543) silently drops notifications, so point this at the direct/session
# connection string (port 5432). When unset it falls back to DATABASE_URL; if
# that cannot LISTEN, the stream degrades to fast snapshot polling.
LIVE_NOTIFY_DATABASE_URL=
# Snapshot cadence on the stream: reconciliation interval while frames flow, and
# the polling interval when push is unavailable.
LIVE_STREAM_SNAPSHOT_INTERVAL_MS=5000
LIVE_STREAM_POLL_INTERVAL_MS=500
# Each stream ends just before the host's function timeout; the browser reconnects.
LIVE_STREAM_MAX_DURATION_MS=50000

# Abstract Email Reputation API key, used to gate self-service signups
# (https://app.abstractapi.com/api/email-reputation). Set this in Render
# environment settings AND redeploy — env var changes only take effect on the next
# deploy. When unset (or on API error/timeout) signup fails OPEN: the account is
# created with reputation status 'unknown' and the reason is recorded for super
# admins in Manage Users. ABSTRACT_API_KEY is accepted as a fallback name.
ABSTRACT_EMAIL_REPUTATION_API_KEY=

# Seed-account passwords (created on first run). Override in production.
SUPER_ADMIN_PASSWORD=
ADMIN_PASSWORD=
USER_PASSWORD=
