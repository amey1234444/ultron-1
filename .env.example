# Copy to .env.local for local dev, or set these in Render environment settings.

# Signing key for CAPTCHA challenges. MUST be a strong random value in prod.
# Generate with: openssl rand -hex 32
AUTH_SECRET=

# Optional dedicated secret for signing CAPTCHA challenges.
# Falls back to AUTH_SECRET when unset.
CAPTCHA_SECRET=

# Canonical public origin, e.g. https://ultron.example.com — used to build the
# password-reset link. STRONGLY RECOMMENDED in production: without it the link is
# built from the request's Host header, which a client controls, so a spoofed
# Host would put an attacker's domain into a reset email.
APP_ORIGIN=

# SMTP, used to send password-reset email. Leave SMTP_HOST empty to disable
# outbound mail entirely — the reset endpoint still answers normally (it must
# never reveal whether an account exists), and outside production it logs the
# reset link to the server console so the flow can be tested without a mail host.
# Port 587 = STARTTLS (default), 465 = implicit TLS. Omit SMTP_USER/SMTP_PASS for
# an unauthenticated relay.

SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=noreplyrotocorp@gmail.com
SMTP_PASSWORD=
SMTP_FROM="Oswar Rotocorp <noreplyrotocorp@gmail.com>"

# REQUIRED in production: Supabase PostgreSQL connection string. Users, opaque
# login sessions, settings, asset hierarchy, rack cards, and canvas layouts are
# all persisted here and survive deploys/restarts.
# Local example:
#   DATABASE_URL=postgres://user:pass@localhost:5432/ultron
# Supabase example (Project Settings -> Database -> Connection string -> URI):
#   DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=

# --- MQTT ingest, inside this application --------------------------------
# The app subscribes to EMQX itself (src/server/ingest), started by server.mjs.
# Nothing calls in: the gateway publishes to the broker, this process subscribes
# to the broker, and browsers subscribe to this process at /ws/live.
#
#   mqtt      = broker subscription only (the pub/sub model; use this)
#   both      = broker + the direct gateway WebSocket door, as a broker-outage
#               fallback (then set DIRECT_WS_GATEWAY_SECRET)
#   websocket = direct gateway door only, no broker
INGEST_TRANSPORT=mqtt
PERSISTENCE_ENABLED=true
# Only needed when the live socket is served from another origin; same-origin
# /ws/live is the default and needs no configuration.
NEXT_PUBLIC_ULTRON_LIVE_WS_URL=
# Require a logged-in session on /ws/live. Defaults to on in production.
LIVE_WS_REQUIRE_SESSION=true
# Fallback door only (INGEST_TRANSPORT=both|websocket); must match the gateway's
# DIRECT_WS_TOKEN. Leave empty in the pub/sub configuration.
DIRECT_WS_GATEWAY_SECRET=

# Optional secret for cron/manual maintenance calls.
# Authorizes POST/GET /api/reputation/process, which drains the durable
# Abstract email-reputation queue at <= 1 request/second. Signup and the Manage
# Users "Re-check" button drain it on demand, so scheduling this is OPTIONAL —
# add it as a scheduled job only if you want backlog stragglers processed
# automatically (e.g. `Authorization: Bearer $CRON_SECRET`).
CRON_SECRET=

# Gateways with no message for this long are marked OFFLINE (last-will backstop,
# swept by the ingest runtime every 5s).
STALE_AFTER_S=15

# EMQX connection used for both the subscription and command publishes. The
# broker user needs subscribe on ultron/v1/gateways/# and publish on
# ultron/v1/gateways/+/racks/+/commands/request.
MQTT_HOST=
MQTT_PORT=8883
MQTT_USE_TLS=true
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_CA_CERT=
MQTT_CLIENT_CERT=
MQTT_CLIENT_KEY=
# Client id prefix; a random suffix is appended per instance so two app
# instances never evict each other from the broker.
MQTT_BACKEND_CLIENT_ID=ultron-app-ingest
MQTT_SUBSCRIBE_QOS=1
# EMQX speaks MQTT 5. Set 4 only for a broker limited to 3.1.1.
MQTT_PROTOCOL_VERSION=5
MQTT_MAX_PAYLOAD_BYTES=262144
# How long POST /api/live/command waits for the gateway's commands/response.
MQTT_COMMAND_TIMEOUT_MS=10000

# Latency is not measured or stored server side. Every frame carries the
# gateway's own created_at_us, so measure it where you care about it:
#   scripts/Watch-MqttLatency.ps1 -BrokerHost <emqx> -Username <user> -Password <pw>

# Realtime delivery (/api/live/stream). Ingest publishes each validated message
# as a live frame on the `ultron_live` PostgreSQL NOTIFY channel before it writes
# anything, and the stream forwards it straight to the browser.
# LISTEN needs a session-mode connection: Supabase's transaction pooler (port
# 6543) silently drops notifications, so point this at the direct/session
# connection string (port 5432). When unset it falls back to DATABASE_URL; if
# that cannot LISTEN, the stream degrades to fast snapshot polling.
LIVE_NOTIFY_DATABASE_URL=
# Snapshot cadence on the stream: reconciliation interval while frames flow, and
# the polling interval when push is unavailable.
LIVE_STREAM_SNAPSHOT_INTERVAL_MS=5000
LIVE_STREAM_POLL_INTERVAL_MS=500
# Each stream ends just before the host's function timeout; the browser reconnects.
LIVE_STREAM_MAX_DURATION_MS=50000

# Abstract Email Reputation API key, used to gate self-service signups
# (https://app.abstractapi.com/api/email-reputation). Set this in Render
# environment settings AND redeploy — env var changes only take effect on the next
# deploy. When unset (or on API error/timeout) signup fails OPEN: the account is
# created with reputation status 'unknown' and the reason is recorded for super
# admins in Manage Users. ABSTRACT_API_KEY is accepted as a fallback name.
ABSTRACT_EMAIL_REPUTATION_API_KEY=

# Seed-account passwords (created on first run). Override in production.
#
# These three carry a committed fallback (superadmin123 / admin123 / user123)
# so a developer can start the app with no configuration. That is fine on a
# laptop and is NOT fine on a deployment: set all three in production, or the
# published defaults are live super-admin credentials.
SUPER_ADMIN_PASSWORD=
ADMIN_PASSWORD=
USER_PASSWORD=

# An additional named super admin, created on first run from these variables
# alone. Nothing about it is committed.
#
# Unlike the three above it has NO fallback password: leave
# SOYA_SUPER_ADMIN_PASSWORD empty and the account is simply not created.
# That is the point — a named production account should not have a password
# anyone can read in the repository.
#
# USERNAME must be 3-32 characters of letters, numbers, dot, underscore or
# hyphen, the same rule the signup form enforces. An email address is not a
# valid username, so put the address in EMAIL: the login form accepts either,
# so the account can be signed into with the address regardless.
#
# Creation is idempotent and keyed on the username. Changing the password here
# later does NOT rotate an existing account — a redeploy quietly resetting a
# super admin's password would be a way to lock the real operator out. Use
# Manage Users or the password-reset flow once the account exists.
#
# Example:
#   SOYA_SUPER_ADMIN_USERNAME=ops
#   SOYA_SUPER_ADMIN_EMAIL=ops@yourcompany.com
#   SOYA_SUPER_ADMIN_NAME=Operations Super Admin
#   SOYA_SUPER_ADMIN_PASSWORD=<at least 8 characters>
SOYA_SUPER_ADMIN_USERNAME=
SOYA_SUPER_ADMIN_EMAIL=
SOYA_SUPER_ADMIN_NAME=
SOYA_SUPER_ADMIN_PASSWORD=

# ---------------------------------------------------------------------------
# ULTRON ML service (services/ml)
# ---------------------------------------------------------------------------
# Advisory, and optional. With ML_SERVICE_URL unset the Analyzer behaves exactly
# as it did before: the deterministic DOC-02..DOC-05 chain runs in the browser
# and remains authoritative, and the Prognosis tab explains why it is empty.
# Nothing in the application waits on this service or fails because of it.
ML_SERVICE_URL=

# Shared secret for the service's internal routes (training, promotion, model
# reload). Both sides must carry the same value. The service fails closed: with
# no token configured those routes are refused outright rather than left open.
ML_INTERNAL_TOKEN=

# How often the server builds a canonical telemetry frame from each twin-screw
# machine's mapped channels and posts it to the service. Floored at 1000.
#
# This is what makes shadow mode produce data: it runs on the server, on a
# timer, whether or not anyone has a console tab open — which is precisely the
# period a developing fault runs through. The service applies its own inference
# cadence on top, so feeding faster than the telemetry arrives buys nothing.
ML_FEED_INTERVAL_MS=5000

# Per-request budget for calls to the service, in milliseconds. Under the
# Analyzer's own patience and well over the measured p99 inference latency
# (~100 ms on a 1,652-column feature union).
ML_TIMEOUT_MS=4000

# How telemetry reaches the models.
#
#   direct    (default) the simulated reading is computed and posted straight
#             to the service. Nothing is written down: no measurement rows, no
#             stored prediction. The shortest path from a value to a score, and
#             the one to run while the storage design is still open.
#   database  the path a real gateway's reading travels: publish, validate,
#             persist, poll, feed. Slower and heavier, and the only one that
#             leaves a history — which is what the health index and remaining
#             life are trended from, and what a model is judged on later.
#   off       neither.
#
# Exclusive. Both at once doubles every machine's rate and makes a prediction
# impossible to attribute to an input.
#
# What `direct` gives up: component health and RUL read measurement_history
# and will report INSUFFICIENT_HISTORY for as long as nothing is stored, and a
# prediction nobody kept cannot be compared against what actually happened.
ML_FEED_MODE=direct
ML_DIRECT_INTERVAL_MS=5000

# error | warn | info | debug. Read by both halves, deliberately: turning up
# one and not the other is never what anybody wants, and the two write the
# same `key=value` shape so one grep spans them.
#
#   info   what arrived and what was decided, one line each
#   debug  every stage, plus the per-fault risks
ML_LOG_LEVEL=info

# Simulated gateways, published server-side. Used by ML_FEED_MODE=database.
#
# A machine wired with generated hardware carries `simulated: true` devices
# and a signal definition on every card. The console turns those into readings
# in the browser; this turns them into readings on the server and publishes
# them through the same ingest path a real gateway uses — validation, dedup,
# persistence, live bus. Without it a simulated machine is visible on screen
# and silent to everything server-side, which is what leaves the Prognosis tab
# saying "no telemetry has been processed for this machine yet".
#
# Only devices marked `simulated` are ever published for. A gateway
# representing real hardware is left alone: its silence is the truth about a
# real machine.
#
# Set to 0 on a deployment with real gateways and no demo machines.
SIMULATE_GATEWAYS=1

# Every tick writes one row per reporting channel to measurement_history.
# Fifty machines at thirteen channels is six hundred rows a tick — roughly
# 180k an hour at ten seconds, and ten times that at one. Floored at 1000.
SIMULATE_GATEWAYS_INTERVAL_MS=10000

# --- read by the Python service itself -------------------------------------
# disabled | shadow | canary | production.
#   shadow      models run, predictions persist, nobody is alerted. The default,
#               and the mode a deployment should live in until engineering has
#               compared predictions against confirmed outcomes for weeks.
#   canary      alerts limited to ML_CANARY_MACHINES / ML_CANARY_FAULTS.
#   production  alerts surface normally.
# Rolling back is a change to this variable.
ML_MODE=shadow
ML_CANARY_MACHINES=
ML_CANARY_FAULTS=

# To see model output in the Prognosis tab, three things have to be true and
# two of them are here. `npm run ml:smoke` replays a fault scenario against a
# running service and says which one is missing rather than leaving the tab
# blank:
#
#   1. ML_SERVICE_URL points at the service, or the web app never calls it.
#   2. ML_MODE is `canary` or `production`. In `shadow` the models run and
#      persist and reach nobody, which looks exactly like a broken tab.
#   3. A champion is registered and loadable. `npm run ml:golden` and
#      /models/champion both say whether one is.
#
# A finding can still appear while ML_MODE is `shadow`. That is the
# deterministic rule layer, which is authoritative and always surfaces —
# ML_MODE gates what the models add, never what an approved limit says.

# How often a model may run per machine. Telemetry may arrive far faster;
# rolling windows are updated on every frame regardless of this value.
ML_INFERENCE_INTERVAL_SECONDS=2

# Optional. When set, rolling windows and decision-filter state survive a
# restart and can be shared across workers. Without it the service must run a
# single worker, or each would see a fraction of the telemetry.
ML_REDIS_URL=

# Leave false. The guard that stops a model fitted on synthetic fixtures being
# promoted to champion; set it only to exercise the promotion path itself.
ML_ALLOW_UNTRAINED_CHAMPION=false

# ---------------------------------------------------------------------------
# SAP S/4HANA integration
# ---------------------------------------------------------------------------
# 32-byte encryption key for SAP credentials stored in PostgreSQL. Generate
# with `openssl rand -base64 32`. Changing this key makes stored credentials
# unreadable, so keep it in the deployment secret manager and back it up.
SAP_CREDENTIALS_ENCRYPTION_KEY=

# Long random bearer secret used by the hosting scheduler to invoke
# /api/sap/cron. Generate separately from the encryption key.
SAP_SYNC_CRON_SECRET=

# Private RFC1918/localhost SAP hosts are blocked by default to protect the
# connector from SSRF. Enable only when this server is intentionally deployed
# inside the customer's network or behind an approved SAP Cloud Connector path.
SAP_ALLOW_PRIVATE_NETWORKS=false

# Outbound request limits. Reads are capped and every request is aborted when
# the timeout expires; this prevents a slow SAP tenant from wedging the app.
SAP_REQUEST_TIMEOUT_MS=15000
SAP_SYNC_PAGE_SIZE=100
SAP_SYNC_MAX_PAGES=5
