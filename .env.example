# Copy to .env.local for local dev, or set these in the Vercel project settings.

# JWT signing key for session cookies. MUST be a strong random value in prod.
# Generate with: openssl rand -hex 32
AUTH_SECRET=

# Optional dedicated secret for signing CAPTCHA challenges.
# Falls back to AUTH_SECRET when unset.
CAPTCHA_SECRET=

# PostgreSQL connection string. When set, users / settings / rate-limit events
# are persisted here; otherwise the app uses an in-memory store (resets on
# restart). Free managed options: Neon (https://neon.tech), Supabase.
# Local example:
#   DATABASE_URL=postgres://user:pass@localhost:5432/ultron
# Hosted example (TLS auto-enabled for non-local hosts):
#   DATABASE_URL=postgres://user:pass@ep-xxx.neon.tech/neondb?sslmode=require
DATABASE_URL=

# Seed-account passwords (created on first run). Override in production.
SUPER_ADMIN_PASSWORD=
ADMIN_PASSWORD=
USER_PASSWORD=
