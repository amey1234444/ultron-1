# Ultron gateway configuration. Copy to .env (dev) or
# /etc/ultron-gateway/gateway.env (Raspberry Pi) and fill in real values.

# --- identity -----------------------------------------------------------
# GATEWAY_ID must match the Gateway Script ID configured in Devices, and the
# rack ids must match the Rack Script IDs, or the backend cannot bind the data.
GATEWAY_ID=ultron-gw-demo-01
RACK_IDS=1
# Operational IP is mandatory in every envelope: set it explicitly or name the
# interface it should be read from (GATEWAY_PRIMARY_INTERFACE=eth0).
GATEWAY_IP=192.168.10.10
#GATEWAY_PRIMARY_INTERFACE=eth0

# --- data source --------------------------------------------------------
# simulator = synthetic rack (dev/Colab), cc_v3 = Ultron Gateway v3 CC telemetry.
DATA_SOURCE=cc_v3
# v3 rewrites this file with the newest normalized frame.
CC_V3_TELEMETRY_PATH=/home/mtb/Desktop/UltronGateway/latest_telemetry.json
# Optional: read newline-delimited frames from a v3 TCP stream instead of the file.
#CC_V3_TCP_HOST=127.0.0.1
#CC_V3_TCP_PORT=5001
# Frames older than this mark the gateway DEGRADED and channels STALE.
CC_STALE_AFTER_S=5
# v3 names racks (`rack_number`), the contract numbers them. Unmapped names fall
# back to their trailing digits (CC_Card_UID1 -> 1).
#RACK_NUMBER_MAP=CC_Card_UID1=1,CC_Card_UID2=2
# One v3 channel per card/slot by default (channel 3 -> slot 3 channel 1).
# Override when several channels sit on one physical card: 1=1.1,7=1.2
#CHANNEL_SLOT_MAP=
CC_CONTROLLER_SLOT=13

# --- broker -------------------------------------------------------------
MQTT_HOST=your-emqx-host
MQTT_PORT=8883
MQTT_TLS=true
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_CA_CERT=/etc/ultron-gateway/certs/emqx-ca.pem

# --- runtime ------------------------------------------------------------
TELEMETRY_INTERVAL_S=0.5
GATEWAY_STATE_DIR=./state
