GATEWAY_ID=GW-001
RACK_ID=1

# Explicit gateway IP takes priority; otherwise the IP of
# GATEWAY_PRIMARY_INTERFACE is used; otherwise startup fails.
GATEWAY_IP=192.168.50.10
#GATEWAY_PRIMARY_INTERFACE=eth0

MQTT_HOST=your-emqx-host
MQTT_PORT=8883
MQTT_USE_TLS=1
MQTT_USERNAME=gateway-user
MQTT_PASSWORD=change-me

# Persistent state (sequence counter + offline spool)
GATEWAY_STATE_DIR=./state

# Telemetry batching interval (handover: 50-100 ms; simulator default is slower)
TELEMETRY_INTERVAL_S=0.5
