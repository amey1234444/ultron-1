  "patterns": [
    {
      "patternId": "P-001",
      "name": "Increased Process Resistance",
      "typicalEvidence": "Pressure HIGH + Torque HIGH + Feed STABLE + RPM STABLE",
      "faultCandidateDirection": "Restriction / high viscosity / low melt temp candidates"
    },
    {
      "patternId": "P-002",
      "name": "Localized Screen Restriction",
      "typicalEvidence": "Pre-screen pressure/ΔP HIGH + context stable",
      "faultCandidateDirection": "Screen restriction candidate"
    },
    {
      "patternId": "P-003",
      "name": "Downstream / Die Restriction",
      "typicalEvidence": "Both upstream/downstream pressure high; screen ΔP not dominant",
      "faultCandidateDirection": "Die/adapter/downstream candidate"
    },
    {
      "patternId": "P-004",
      "name": "Feed-Driven Instability",
      "typicalEvidence": "Feed OSCILLATING; torque/pressure follow with lag; RPM stable",
      "faultCandidateDirection": "Feeder/control/material-flow candidates"
    },
    {
      "patternId": "P-005",
      "name": "Feed Starvation",
      "typicalEvidence": "Feed actual LOW vs SP + torque/current/throughput fall",
      "faultCandidateDirection": "Hopper/feeder/feed-throat candidates"
    },
    {
      "patternId": "P-006",
      "name": "High-Viscosity Behaviour",
      "typicalEvidence": "Torque/pressure HIGH + melt temp LOW or recipe/material changed",
      "faultCandidateDirection": "Viscosity/material/thermal candidate"
    },
    {
      "patternId": "P-007",
      "name": "Thermal Control Instability",
      "typicalEvidence": "Zone temp oscillates at unchanged SP; output oscillates/saturates",
      "faultCandidateDirection": "Heater/cooling/control/sensor candidate"
    },
    {
      "patternId": "P-008",
      "name": "Cooling Ineffective",
      "typicalEvidence": "Temp rising + cooling demand high + stable feed/RPM",
      "faultCandidateDirection": "Cooling utility/valve/flow candidate"
    },
    {
      "patternId": "P-009",
      "name": "Vacuum / Degassing Problem",
      "typicalEvidence": "Vacuum poor + process context valid",
      "faultCandidateDirection": "Leak/pump/blockage/flooding/volatile load candidate"
    },
    {
      "patternId": "P-010",
      "name": "Mechanical Drag",
      "typicalEvidence": "Torque/current high + weak pressure evidence + gearbox/motor thermal/vibration evidence",
      "faultCandidateDirection": "Drive-train/mechanical candidate"
    },
    {
      "patternId": "P-011",
      "name": "Instrumentation Suspicion",
      "typicalEvidence": "One signal abnormal + related signals physically unchanged/contradictory",
      "faultCandidateDirection": "Sensor/scaling/tag/port issue"
    },
    {
      "patternId": "P-012",
      "name": "Unknown Abnormal Pattern",
      "typicalEvidence": "Strong multi-signal anomaly but no known pattern fits",
      "faultCandidateDirection": "FAULT_UNKNOWN; engineering review"
    }
  ]
