# EMQX broker (TLS)
MQTT_URL=mqtts://your-emqx-host:8883
MQTT_USERNAME=backend-user
MQTT_PASSWORD=change-me
MQTT_CLIENT_ID=ultron-backend-ingress-01
# Set to 0 only for local brokers without TLS certificates
MQTT_REJECT_UNAUTHORIZED=1

# Supabase / PostgreSQL (same database the Next.js app uses)
DATABASE_URL=postgresql://user:password@host:6543/postgres

# Optional realtime WebSocket broadcast for downstream consumers
WS_PORT=8081

# Gateways go OFFLINE if silent for this long (last-will backstop)
STALE_AFTER_S=15
