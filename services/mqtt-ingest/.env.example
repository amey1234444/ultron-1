# Direct gateway WebSocket ingest for Render. This is the default transport and
# removes EMQX from the live data path.
INGEST_TRANSPORT=websocket
PORT=8081
GATEWAY_WS_PATH=/ws/gateway
LIVE_WS_PATH=/ws/live
DIRECT_WS_GATEWAY_SECRET=generate-a-long-random-secret
# Optional. If set, browser live WebSocket clients must pass ?token=<value>.
DIRECT_WS_BROWSER_TOKEN=
DIRECT_WS_MAX_PAYLOAD_BYTES=262144
# false = present live frames first and skip DB writes; true = queue persistence
# behind the live frame. Defaults to true when DATABASE_URL is set.
PERSISTENCE_ENABLED=true

# EMQX broker fallback. Used only when INGEST_TRANSPORT=mqtt or both.
MQTT_HOST=your-emqx-host
MQTT_PORT=8883
MQTT_USE_TLS=true
MQTT_USERNAME=backend-user
MQTT_PASSWORD=change-me
MQTT_CLIENT_ID=ultron-backend-ingress-01
# Set to 0 only for local brokers without TLS certificates
MQTT_REJECT_UNAUTHORIZED=1

# Supabase / PostgreSQL (same database the Next.js app uses)
DATABASE_URL=postgresql://user:password@host:6543/postgres

# Gateways go OFFLINE if silent for this long (last-will backstop)
STALE_AFTER_S=15

# How often buffered ingest metrics are written (they no longer cost a round trip
# per message).
METRICS_FLUSH_INTERVAL_MS=2000

# Budget for gateway sample -> live frame published; exceeding it logs a warning
# (at most once per 5s) with the measured latency.
LATENCY_BUDGET_MS=1000
